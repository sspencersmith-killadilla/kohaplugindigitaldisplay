<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>Photo Signage</title>
    <style>
        :root { color-scheme: dark; }
        * { box-sizing: border-box; }
        html, body { width:100%;height:100%;margin:0;background:#05070b;color:#fff;overflow:hidden;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
        .stage { position:relative;width:100vw;height:100vh;height:100dvh;background:#05070b; }
        .slide { position:absolute;inset:0;margin:0;display:grid;place-items:center;opacity:0;visibility:hidden;pointer-events:none;transition:opacity 850ms ease; }
        .slide.active { opacity:1;visibility:visible;pointer-events:auto; }
        .slide img, .slide video, .slide iframe, .slide object { display:block;width:100%;height:100%;border:0; }
        .slide img, .slide video { object-fit:[% fit | html %]; }
        .slide iframe, .slide object { background:#05070b; }
        .text-content { width:min(90vw,1200px);max-height:82vh;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;text-align:center;font-size:clamp(2rem,5vw,5.5rem);font-weight:650;line-height:1.2;padding:2rem; }
        .caption { position:absolute;left:0;right:0;bottom:0;padding:3rem clamp(1.5rem,5vw,5rem) 2.2rem;background:linear-gradient(transparent,rgba(0,0,0,.78));font-size:clamp(1.1rem,2.4vw,2.6rem);font-weight:600;text-shadow:0 2px 16px #000; }
        .external-hint { position:absolute;z-index:3;left:1rem;top:1rem;max-width:min(34rem,80vw);padding:.6rem .85rem;border-radius:5px;background:rgba(20,25,33,.82);font-size:.9rem; }
        .external-hint a { color:#a9e7dc; }
        .media-error { position:absolute;z-index:4;inset:auto 1rem 1rem;padding:1rem;border:1px solid rgba(255,255,255,.3);border-radius:6px;background:rgba(35,15,15,.94);text-align:center; }
        .media-error[hidden] { display:none; }
        .controls { position:absolute;z-index:5;top:1rem;right:1rem;display:flex;gap:.5rem;opacity:0;transition:opacity .25s ease; }
        .stage:hover .controls,.stage:focus-within .controls,.controls.visible { opacity:1; }
        .controls button { color:#fff;background:rgba(20,25,33,.8);border:1px solid rgba(255,255,255,.35);border-radius:5px;padding:.65rem .9rem;font-size:.95rem;cursor:pointer; }
        .progress { position:absolute;z-index:4;bottom:0;left:0;height:4px;width:100%;background:#8bd3c7;transform:scaleX(0);transform-origin:left; }
        .empty { display:grid;place-items:center;width:100%;height:100%;color:#cbd5e1;text-align:center;padding:2rem;font-size:1.25rem; }
        @keyframes progress { from { transform:scaleX(0); } to { transform:scaleX(1); } }
        @media (prefers-reduced-motion: reduce) { .slide { transition:none; } }
    </style>
</head>
<body>
    <main class="stage" id="stage" aria-label="Digital signage slideshow">
        [% IF slides.size %]
            [% FOREACH slide IN slides %]
                <figure class="slide" data-type="[% slide.media_type | html %]" data-duration="[% slide.duration_seconds | html %]">
                    [% IF slide.media_type == 'image' %]
                        <img data-src="[% slide.asset_url | html %]" alt="[% slide.caption | html %]" [% IF loop.first %]fetchpriority="high"[% ELSE %]loading="lazy"[% END %]>
                    [% ELSIF slide.media_type == 'video' %]
                        <video data-src="[% slide.asset_url | html %]" muted playsinline preload="none" aria-label="[% slide.caption | html %]"></video>
                    [% ELSIF slide.media_type == 'youtube' || slide.media_type == 'vimeo' %]
                        <iframe src="about:blank" data-src="[% slide.embed_url | html %]" title="[% slide.caption | html %]" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
                    [% ELSIF slide.media_type == 'webpage' %]
                        <iframe src="about:blank" data-src="[% slide.embed_url | html %]" title="[% slide.caption | html %]" sandbox="allow-scripts allow-same-origin allow-forms" allow="fullscreen; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin"></iframe>
                        <div class="external-hint">External pages may block embedding. If this stays blank, the site does not allow display here.</div>
                    [% ELSIF slide.media_type == 'pdf' %]
                        <iframe src="about:blank" data-src="[% slide.asset_url | html %]" title="[% slide.caption | html %]">
                            <p>PDF preview is not available in this browser. <a href="[% slide.asset_url | html %]" target="_blank" rel="noopener">Open the PDF</a>.</p>
                        </iframe>
                        <div class="external-hint">If the PDF does not appear, open it directly: <a href="[% slide.asset_url | html %]" target="_blank" rel="noopener noreferrer">Open PDF</a></div>
                    [% ELSIF slide.media_type == 'text' %]
                        <div class="text-content">[% slide.text | html %]</div>
                    [% END %]
                    [% IF slide.caption %]<figcaption class="caption">[% slide.caption | html %]</figcaption>[% END %]
                </figure>
            [% END %]
            <div class="controls visible" id="controls">
                <button type="button" id="pause" aria-label="Pause slideshow">Pause</button>
                <button type="button" id="fullscreen">Enter full screen</button>
            </div>
            <div class="progress" id="progress" aria-hidden="true"></div>
            <div class="media-error" id="media-error" role="status" hidden>
                <span id="media-error-text"></span>
                <button type="button" id="skip-slide">Skip slide</button>
            </div>
        [% ELSE %]
            <div class="empty">No slides are currently available.</div>
        [% END %]
    </main>
    [% IF slides.size %]
    <script>
        (function () {
            const slides = Array.from(document.querySelectorAll('.slide'));
            const interval = [% interval_seconds | html %] * 1000;
            const pauseButton = document.getElementById('pause');
            const fullButton = document.getElementById('fullscreen');
            const stage = document.getElementById('stage');
            const progress = document.getElementById('progress');
            const mediaError = document.getElementById('media-error');
            const mediaErrorText = document.getElementById('media-error-text');
            let current = 0;
            let timer = null;
            let paused = false;
            let remaining = null;
            let deadline = 0;

            function stopTimer() {
                clearTimeout(timer);
                timer = null;
                deadline = 0;
            }
            function slideDuration() {
                const seconds = Number(slides[current].dataset.duration);
                return Number.isInteger(seconds) && seconds >= 1 && seconds <= 86400
                    ? seconds * 1000 : (slides[current].dataset.type === 'video' ? null : interval);
            }
            function startCountdown(milliseconds) {
                stopTimer();
                remaining = milliseconds;
                if (paused || milliseconds === null || slides.length < 2) return;
                deadline = Date.now() + milliseconds;
                progress.style.transition = 'transform ' + milliseconds + 'ms linear';
                progress.style.transform = 'scaleX(1)';
                timer = setTimeout(advance, milliseconds);
            }
            function showError(text, skipAfterDelay) {
                mediaErrorText.textContent = text;
                mediaError.hidden = false;
                if (skipAfterDelay) {
                    stopTimer();
                    timer = setTimeout(advance, 5000);
                }
            }
            function advance() {
                if (paused || slides.length < 2) return;
                showSlide((current + 1) % slides.length);
            }
            function releaseCurrentMedia() {
                const previous = slides[current];
                const previousVideo = previous.querySelector('video');
                if (previousVideo) {
                    previousVideo.onplaying = previousVideo.onended = previousVideo.onerror = null;
                    previousVideo.pause();
                    previousVideo.removeAttribute('src');
                    previousVideo.load();
                }
                const previousFrame = previous.querySelector('iframe[data-src]');
                if (previousFrame) {
                    previousFrame.src = 'about:blank';
                    previousFrame.dataset.loaded = '';
                }
            }
            function showSlide(index) {
                stopTimer();
                mediaError.hidden = true;
                document.getElementById('skip-slide').hidden = slides.length < 2;
                slides[current].classList.remove('active');
                releaseCurrentMedia();
                current = index;
                remaining = slideDuration();
                const slide = slides[current];
                slide.classList.add('active');
                progress.style.transition = 'none';
                progress.style.transform = 'scaleX(0)';
                const image = slide.querySelector('img[data-src]');
                if (image) {
                    image.onerror = function () {
                        showError(slides.length > 1 ? 'This image could not be loaded. Moving on shortly.' : 'This image could not be loaded.', slides.length > 1);
                    };
                    if (!image.getAttribute('src')) image.src = image.dataset.src;
                }
                const frame = slide.querySelector('iframe[data-src]');
                if (frame && !frame.dataset.loaded) {
                    frame.src = frame.dataset.src;
                    frame.dataset.loaded = '1';
                }
                if (slide.dataset.type === 'video') {
                    const video = slide.querySelector('video');
                    if (!video.getAttribute('src')) {
                        video.src = video.dataset.src;
                        video.load();
                    }
                    video.loop = slides.length === 1;
                    video.onended = advance;
                    video.onplaying = function () {
                        // Start the optional limit after playback starts, not while loading.
                        if (deadline > 0) remaining = Math.max(0, deadline - Date.now());
                        startCountdown(remaining);
                    };
                    video.onerror = function () {
                        showError(slides.length > 1 ? 'This video could not be played. Moving on shortly.' : 'This video could not be played.', slides.length > 1);
                    };
                    if (slides.length > 1) {
                        timer = setTimeout(function () {
                            if (video.paused && !video.ended) {
                                showError('This video did not start. Check that the browser allows muted autoplay.', true);
                            }
                        }, 10000);
                    }
                    const play = video.play();
                    if (play && typeof play.catch === 'function') {
                        play.catch(function () {
                            showError(slides.length > 1 ? 'This video could not start automatically. Moving on shortly.' : 'This video could not start automatically.', slides.length > 1);
                        });
                    }
                } else if (slides.length > 1) {
                    requestAnimationFrame(function () {
                        startCountdown(remaining);
                    });
                }
            }
            pauseButton.addEventListener('click', function () {
                paused = !paused;
                pauseButton.textContent = paused ? 'Resume' : 'Pause';
                pauseButton.setAttribute('aria-label', paused ? 'Resume slideshow' : 'Pause slideshow');
                const video = slides[current].querySelector('video');
                if (paused && remaining !== null && timer !== null && deadline > 0) {
                    remaining = Math.max(0, deadline - Date.now());
                }
                if (video) {
                    if (paused) video.pause();
                    else video.play().catch(function () {
                        showError('This video could not resume.', false);
                    });
                }
                if (paused) {
                    const frozenProgress = window.getComputedStyle(progress).transform;
                    stopTimer();
                    progress.style.transition = 'none';
                    progress.style.transform = frozenProgress;
                } else if (slides[current].dataset.type === 'video') {
                    // onplaying resumes the optional limit; onended handles automatic timing.
                } else if (slides.length > 1) {
                    startCountdown(remaining);
                }
            });
            fullButton.addEventListener('click', function () {
                if (!document.fullscreenElement && stage.requestFullscreen) {
                    stage.requestFullscreen();
                } else if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            });
            document.addEventListener('fullscreenchange', function () {
                fullButton.textContent = document.fullscreenElement ? 'Exit full screen' : 'Enter full screen';
            });
            document.getElementById('skip-slide').addEventListener('click', advance);
            stage.addEventListener('mousemove', function () {
                const controls = document.getElementById('controls');
                controls.classList.add('visible');
                clearTimeout(window.controlsHideTimer);
                window.controlsHideTimer = setTimeout(function () {
                    controls.classList.remove('visible');
                }, 2500);
            });
            window.controlsHideTimer = setTimeout(function () {
                document.getElementById('controls').classList.remove('visible');
            }, 4000);
            showSlide(0);
        }());
    </script>
    [% END %]
</body>
</html>
