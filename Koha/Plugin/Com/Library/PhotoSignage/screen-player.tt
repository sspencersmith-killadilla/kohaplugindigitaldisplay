<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>Library signage</title>
    <style>[% player_css %]</style>
</head>
<body>
    <main id="screen" aria-label="Library signage"></main>
    <div id="screen-controls"><button id="screen-fullscreen" type="button">Enter full screen</button><span id="screen-status" role="status"></span></div>
    <script type="application/json" id="screen-boot">[% boot_json %]</script>
    <script>[% player_js %]</script>
</body>
</html>
